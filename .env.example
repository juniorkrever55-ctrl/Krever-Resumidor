# Nunca versionar a chave real. Copie este arquivo para .env e preencha o valor.
GROQ_API_KEY=

# Modelos da Groq
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Modelo multimodal usado para ler simulações recebidas como imagem (precisa suportar visão)
# EM SET/2026 APENAS: qwen/qwen3.6-27b e qwen/qwen3.8-27b suportam image_url (ver https://console.groq.com/docs/vision)
# openai/gpt-oss-20b/120b são TEXTO PURO e retornam vazio se mandar imagem -> NÃO USE para visão
# Modelos antigos descontinuados: meta-llama/llama-4-scout-17b-16e-instruct (jul/2026), meta-llama/llama-4-maverick-17b-128e-instruct (mar/2026)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Salva um .txt local com o prompt e o contexto exato enviado a cada resumo (sem chave de API).
SAVE_AI_REQUESTS=true
# Opcional: URL de uma conversa específica do Gemini para o botão “Preparar para Gemini”.
GEMINI_CHAT_URL=https://gemini.google.com/app

# Fuso de todas as datas/horas exibidas e exportadas (TXT do Gemini, resumo, painel).
# As mensagens são gravadas em UTC; sem este fuso o horário saía 3h adiantado no TXT.
APP_TIME_ZONE=America/Sao_Paulo

PORT=3000
# Abre o painel no Chrome automaticamente após npm start. Use false para desativar.
OPEN_BROWSER=true
# Ative apenas quando precisar investigar falha no QR/conexão; exibe logs do Baileys no terminal.
DEBUG_WHATSAPP=false
# Para você ouvir e decidir quais áudios transcrever, os arquivos recebidos ficam somente em data/audio/.
STORE_AUDIO_FOR_MANUAL_TRANSCRIPTION=true
# Guarda imagens de simulação localmente para análise independente.
STORE_IMAGES_FOR_SUMMARY=true
# Limite do arquivo de imagem antes da codificação em base64 para a Groq Vision.
MAX_VISION_IMAGE_BYTES=14680064
# Importa o histórico que o WhatsApp Web disponibilizar ao fazer um novo pareamento.
IMPORT_HISTORY=true
# Evita registros duplicados durante a sincronização do histórico.
MAX_TRACKED_MESSAGE_IDS=100000
# Limite abaixo de 25 MB para a transcrição.
MAX_AUDIO_BYTES=25165824
# Limite de segurança para aceitar textos locais completos antes de enviar à IA.
MAX_SUBMITTED_SUMMARY_CHARS=1000000

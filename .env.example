# Nunca versionar a chave real. Copie este arquivo para .env e preencha o valor.
GROQ_API_KEY=

# Modelos da Groq (não confundir Groq com Grok/xAI)
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

PORT=3000
# Por privacidade, os áudios originais não são salvos; apenas a transcrição entra no histórico.
SAVE_AUDIO_FILES=false
# Importa o histórico que o WhatsApp Web disponibilizar ao fazer um novo pareamento.
# Essa importação é local e não envia texto para a Groq.
IMPORT_HISTORY=true
# Áudios que já estavam no histórico não são transcritos por padrão, evitando custo na Groq.
# Áudios recebidos depois da conexão continuam sendo transcritos.
TRANSCRIBE_HISTORY_AUDIO=false
# Evita registros duplicados durante a sincronização do histórico.
MAX_TRACKED_MESSAGE_IDS=100000
# Limite abaixo de 25 MB para a transcrição.
MAX_AUDIO_BYTES=25165824
MAX_SUMMARY_CHARS=50000
